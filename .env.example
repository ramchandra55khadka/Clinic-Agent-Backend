# Copy to `.env` and fill in. Every value has a safe development default, but a
# production deployment is validated at startup and refuses to boot without a
# strong JWT_SECRET_KEY, explicit ALLOWED_ORIGINS and a GOOGLE_API_KEY.

# ------------------------------------------------------------------ core ----
APP_NAME="Clinic Assistant API"
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true in production (one JSON object per line)
ENABLE_DOCS=true                 # false in production
CREATE_TABLES_ON_STARTUP=true    # false in production — use `alembic upgrade head`

# -------------------------------------------------------------- database ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/clinicdb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------- auth ----
# Generate with: openssl rand -hex 32   (>= 32 characters, enforced in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=clinic-agent
JWT_AUDIENCE=clinic-agent-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ------------------------------------------- brute-force / abuse protection ----
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10              # requests per window, per client IP
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600

# ------------------------------------------------------------------ clinic ----
# All time/date logic (working hours, "is this slot in the past") uses this zone.
CLINIC_TIMEZONE=Asia/Kathmandu

# --------------------------------------------------------- CORS and proxy ----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=*                  # list explicit hostnames in production

# --------------------------------------------------------------------- AI ----
GOOGLE_API_KEY=
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ------------------------------------------------------------------ email ----
EMAIL_ENABLED=false              # appointment confirmations are skipped when false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@clinic.local
SMTP_USE_TLS=true
