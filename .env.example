#Google API Key
GOOGLE_API_KEY=
# Google AI (Gemini) — model and temperature used by all agents
GOOGLE_AI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
# Set to 0 to disable local throttling; defaults to 2 seconds in development.
LLM_REQUEST_DELAY_SECONDS=2
# PDF chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=120


#Database:
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

ALLOWED_ORIGINS=
TRUSTED_HOSTS=*                  # list explicit hostnames in production
